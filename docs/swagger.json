{
    "swagger": "2.0",
    "info": {
        "description": "BeeHub Ders Seçim Botu için API dokümantasyonu.",
        "title": "BeeHub Ders Seçim Botu API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/auth/login": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Login and get token",
                "parameters": [
                    {
                        "description": "Login credentials",
                        "name": "login",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/auth.LoginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "token",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "400": {
                        "description": "validation error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "401": {
                        "description": "login failed",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "internal server error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "502": {
                        "description": "kepler service unavailable",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/auth/logout": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Logout user",
                "responses": {
                    "200": {
                        "description": "message",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/auth/profile": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Get authenticated user profile",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.PersonDTO"
                        }
                    },
                    "401": {
                        "description": "unauthenticated",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "404": {
                        "description": "profile not found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "internal server error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/beePicker/courses": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "BeePicker"
                ],
                "summary": "Retrieves courses from the BeePicker.",
                "responses": {
                    "200": {
                        "description": "course list",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "500": {
                        "description": "internal server error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "502": {
                        "description": "cannot retrieve course information",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/beePicker/pick": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Picks courses (ECRN) and/or drops courses (SCRN) based on the request.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "BeePicker"
                ],
                "summary": "Picks or drops courses from Kepler.",
                "parameters": [
                    {
                        "description": "Request body containing courses to add and/or drop",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/beepicker.pickRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Operation successful",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "400": {
                        "description": "Bad request",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/start-service": {
            "get": {
                "description": "Starts the BeeHubBot process as a background process",
                "tags": [
                    "Service"
                ],
                "summary": "Start the BeeHubBot process",
                "responses": {
                    "200": {
                        "description": "Process started",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Error starting process",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/stop-service": {
            "get": {
                "description": "Stops the BeeHubBot process",
                "tags": [
                    "Service"
                ],
                "summary": "Stop the BeeHubBot process",
                "responses": {
                    "200": {
                        "description": "Process stopped",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Error stopping process",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "auth.LoginRequest": {
            "type": "object",
            "required": [
                "email",
                "password"
            ],
            "properties": {
                "email": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            }
        },
        "beepicker.CourseRequest": {
            "type": "object",
            "required": [
                "crn"
            ],
            "properties": {
                "crn": {
                    "type": "string"
                },
                "reserves": {
                    "description": "Yedek dersler, ana ders başarısız olursa denenir",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/beepicker.CourseRequest"
                    }
                }
            }
        },
        "beepicker.pickRequest": {
            "type": "object",
            "properties": {
                "ECRN": {
                    "description": "Alternatif alan adları - doğrudan ECRN/SCRN kullanımı için",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "SCRN": {
                    "description": "Silinecek CRN'ler (basit liste)",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "courses": {
                    "description": "Eklenecek dersler - detaylı yapı ile (rezerve destekli)",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/beepicker.CourseRequest"
                    }
                },
                "dropCourses": {
                    "description": "Silinecek ders CRN'leri (SCRN olarak gönderilir)",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "models.PersonDTO": {
            "type": "object",
            "properties": {
                "class": {
                    "type": "string"
                },
                "department": {
                    "type": "string"
                },
                "email": {
                    "type": "string"
                },
                "faculty": {
                    "type": "string"
                },
                "first_name": {
                    "type": "string"
                },
                "gpa": {
                    "type": "string"
                },
                "last_name": {
                    "type": "string"
                },
                "photo": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "Authorization header with Bearer token. Example: \"Bearer {token}\"",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}